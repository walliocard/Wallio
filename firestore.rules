rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /marchands/{marchandId} {
      allow read: if true;
      // Marchand authentifié peut modifier uniquement son propre document
      allow write: if request.auth != null && request.auth.uid == marchandId;
    }
    match /clients/{clientId} {
      // Lecture ouverte : flux NFC sans auth + dashboard marchand
      allow read: if true;
      // Création — flux NFC sans auth
      allow create: if request.resource.data.marchand_id is string;
      // Mise à jour — marchand_id immuable (NFC + dashboard)
      allow update: if resource.data.marchand_id == request.resource.data.marchand_id;
      // Suppression — marchand authentifié uniquement
      allow delete: if request.auth != null && resource.data.marchand_id == request.auth.uid;
    }
  }
}
